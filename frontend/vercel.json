{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://mining-dakota-five-container.trycloudflare.com/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://mining-dakota-five-container.trycloudflare.com/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://mining-dakota-five-container.trycloudflare.com/admin/:path*"
    },
    {
      "source": "/skills/:path*",
      "destination": "https://mining-dakota-five-container.trycloudflare.com/skills/:path*"
    },
    {
      "source": "/ai-learning/:path*",
      "destination": "https://mining-dakota-five-container.trycloudflare.com/ai-learning/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
